{
  "name": "mzm-identicon",
  "private": true,
  "version": "2.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/deploy.ts deploy",
    "deploy:dry-run": "node scripts/deploy.ts dry-run",
    "test:deploy": "MZM_RUN_DEPLOY_INTEGRATION=1 vitest run test/deploy.test.ts",
    "format": "prettier --write src scripts test vitest.config.ts wrangler.jsonc package.json package-lock.json tsconfig.json",
    "test": "vitest run",
    "prelint": "tsc --noEmit",
    "lint": "vp lint src",
    "lint-fix": "vp lint src --fix",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "^3.10.1",
    "typescript": "^5.8.3",
    "vite-plus": "^1.7.0",
    "vitest": "^5.1.1",
    "wrangler": "4.166.0"
  }
}
